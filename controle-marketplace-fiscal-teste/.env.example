FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-ambiente-real
DATABASE_URL=sqlite:///storage/app.db

# Credencial demo local. Em producao, troque no Environment do Render.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@teste.com
INITIAL_ADMIN_PASSWORD=Teste1234

AUTO_GENERATE_FAKE_ORDERS=false
FAKE_ORDER_INTERVAL_MINUTES=10
ENABLE_AUTO_SEED=false

# Seguranca de sessao/autenticacao.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
WTF_CSRF_TIME_LIMIT_SECONDS=3600
BCRYPT_LOG_ROUNDS=12
SECURITY_HEADERS_ENABLED=true

# Ao baixar XML/PDF fake, o navegador faz download normal.
# Em execucao local no Windows, o app tambem pode salvar uma copia nesta pasta.
LOCAL_DOWNLOAD_COPY_ENABLED=true
# LOCAL_DOWNLOAD_DIR=C:\Users\SEU_USUARIO\Downloads\controle-marketplace-fiscal-teste

# Opcional: caminho de um PDF real usado apenas como referencia visual/manual.
# O sistema nao copia dados reais desse arquivo para as notas ficticias.
# FAKE_INVOICE_TEMPLATE_PDF=C:\Users\REDFIT\Downloads\nota-fiscal-notebook-dell.pdf

# Somente se quiser testar PostgreSQL localmente.
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/controle_fiscal_teste
